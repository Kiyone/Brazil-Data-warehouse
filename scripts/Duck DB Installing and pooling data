# check the data.Parquet + make them CSV
  #Check the data.parquet in DuckDB and CSV-ise
  duckdb -c "SELECT * FROM read_parquet('~/projects/Brazil Data/DATA/AC/ETLSIM.DORES_AC_2003_t.parquet') LIMIT 5;"
  duckdb -c "COPY (SELECT * FROM read_parquet('~/projects/Brazil Data/DATA/AC/ETLSIM.DORES_AC_2003_t.parquet')) TO '/Users/kiyomotoyuuki/projects/Brazil Data/DATA/AC/ETLSIM.DORES_AC_2003_t.csv' (HEADER, DELIMITER ',');"

  # python code
  cd "~/projects/Brazil Data"
  cat > parquet_to_csv.py <<'PY'
  import argparse
  from pathlib import Path
  import pandas as pd
  ap = argparse.ArgumentParser()
  ap.add_argument("--input", required=True)
  ap.add_argument("--head", type=int, default=0)
  ap.add_argument("--out")
  args = ap.parse_args()
  df = None
  if args.head > 0:
    df = pd.read_parquet(args.input)
    print(df.shape); print(df.head(args.head))
  if args.out:
    if df is None: df = pd.read_parquet(args.input)
    Path(args.out).parent.mkdir(parents=True, exist_ok=True)
    df.to_csv(args.out, index=False)
    print(f"wrote: {args.out} rows={len(df):,}")
  PY

# example of execucion
python parquet_to_csv.py --input "~/projects/Brazil Data/DATA/AC/ETLSIM.DORES_AC_2003_t.parquet" --head 5
python parquet_to_csv.py --input "~/projects/Brazil Data/DATA/AC/ETLSIM.DORES_AC_2003_t.parquet" --out "~/projects/Brazil Data/DATA/AC/ETLSIM.DORES_AC_2003_t.csv"


# making Duck DB + Importing data
mkdir -p "/Users/kiyomotoyuuki/projects/Brazil Data/WAREHOUSE"

duckdb "/Users/kiyomotoyuuki/projects/Brazil Data/WAREHOUSE/dores.duckdb" -c "
CREATE OR REPLACE TABLE dores AS
SELECT
  * REPLACE (CAST(DTNASC AS VARCHAR) AS DTNASC),
  CAST(regexp_extract(filename, '(\\d{4})', 1) AS INTEGER) AS year,
  regexp_extract(filename, '/([A-Z]{2})/ETLSIM', 1)         AS uf
FROM read_parquet(
  '/Users/kiyomotoyuuki/projects/Brazil Data/DATA/*/ETLSIM.DORES_*_t.parquet',
  filename=true,
  union_by_name=true
);
CREATE INDEX IF NOT EXISTS idx_dores_uf_year ON dores(uf, year);
"

#Confirm Duck DB
duckdb "/Users/kiyomotoyuuki/projects/Brazil Data/WAREHOUSE/dores.duckdb" -c "DESCRIBE dores; SELECT filename, uf, year FROM dores LIMIT 3;"

