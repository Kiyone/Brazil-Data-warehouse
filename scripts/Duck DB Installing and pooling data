# Import data into Duck DB
duckdb "/Users/kiyomotoyuuki/projects/Brazil Data/WAREHOUSE/dores.duckdb" -c "
CREATE TABLE IF NOT EXISTS codebook(
  var TEXT, label_en TEXT, descr_en TEXT, source TEXT
);
DELETE FROM codebook;
COPY codebook FROM '/Users/kiyomotoyuuki/projects/Brazil Data/WAREHOUSE/codebook.csv' (HEADER, DELIMITER ',');
SELECT COUNT(*) AS n_rows_in_codebook FROM codebook;
SELECT * FROM codebook LIMIT 8;
"

# data cleaning 
duckdb "~/projects/Brazil Data/WAREHOUSE/dores.duckdb" -c "
CREATE OR REPLACE VIEW dores_clean AS
WITH pre AS (
  SELECT
    uf, year, CAUSABAS, SEXO, RACACOR, DTOBITO, DTNASC,
    regexp_replace(CAST(DTOBITO AS VARCHAR), '[^0-9]', '', 'g') AS d_obito_num,
    regexp_replace(CAST(DTNASC  AS VARCHAR), '[^0-9]', '', 'g') AS d_nasc_num,
    *
  FROM dores
),
norm AS (
  SELECT
    *,
    LPAD(d_obito_num, 8, '0') AS d_obito_8,
    LPAD(d_nasc_num , 8, '0') AS d_nasc_8
  FROM pre
),
fmt AS (
  SELECT
    *,
    CASE WHEN LENGTH(d_obito_8)=8
         THEN substr(d_obito_8,5,4)||'-'||substr(d_obito_8,3,2)||'-'||substr(d_obito_8,1,2)
         ELSE NULL END AS d_obito_iso,
    CASE WHEN LENGTH(d_nasc_8)=8
         THEN substr(d_nasc_8 ,5,4)||'-'||substr(d_nasc_8 ,3,2)||'-'||substr(d_nasc_8 ,1,2)
         ELSE NULL END AS d_nasc_iso
  FROM norm
)
SELECT
  uf,
  year,
  TRY_STRPTIME(d_obito_iso, '%Y-%m-%d')::DATE AS date_death,
  TRY_STRPTIME(d_nasc_iso , '%Y-%m-%d')::DATE AS date_birth,
  TRY_CAST(SEXO AS INTEGER)     AS sex_code,
  TRY_CAST(RACACOR AS INTEGER)  AS race_code,
  CAUSABAS                      AS icd10_underlying,
  *
FROM fmt;

SELECT uf, year, DTOBITO, DTNASC, date_death, date_birth, sex_code, race_code, icd10_underlying
FROM dores_clean LIMIT 5;
"

#subset importing 
 # 5-1. MS/2016（raw ）
duckdb "~/projects/Brazil Data/WAREHOUSE/dores.duckdb" -c "
COPY (
  SELECT *
  FROM dores
  WHERE uf='MS' AND year=2016
) TO '/Users/kiyomotoyuuki/projects/Brazil Data/WAREHOUSE/ETLSIM_DORES_MS_2016_raw.csv'
(HEADER, DELIMITER ',');
"

 #5-2 MS/2016(clean)
duckdb "/Users/kiyomotoyuuki/projects/Brazil Data/WAREHOUSE/dores.duckdb" -c "
COPY (
  SELECT uf, year, date_death, date_birth, sex_code, race_code, icd10_underlying
  FROM dores_clean
  WHERE uf='MS' AND year=2016
) TO '/Users/kiyomotoyuuki/projects/Brazil Data/WAREHOUSE/ETLSIM_DORES_MS_2016_clean.csv'
(HEADER, DELIMITER ',');
"
