## 0)Packages
```{r}
# Load required libraries
# install.packages( c("DBI","duckdb","data.table","lubridate","gnm","dlnm","ggplot2","mgcv","dplyr"),repos = "https://cloud.r-project.org")
library(DBI); library(duckdb) # DuckDB related
